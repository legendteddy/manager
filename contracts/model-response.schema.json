{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/legendteddy/manager/contracts/model-response.schema.json",
  "title": "Manager Model Response",
  "type": "object",
  "required": ["response_id", "provider", "model", "status", "output_text", "usage"],
  "properties": {
    "response_id": {"type": ["string", "null"]},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "incomplete", "failed"]},
    "output_text": {"type": "string"},
    "tool_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proposal_id", "tool_name", "arguments"],
        "properties": {
          "proposal_id": {"type": "string", "minLength": 1},
          "tool_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "arguments": {"type": "object", "additionalProperties": true},
          "target": {"type": ["string", "null"]},
          "source_ref": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
