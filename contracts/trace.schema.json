{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/legendteddy/manager/contracts/trace.schema.json",
  "title": "Manager Trace",
  "type": "object",
  "required": ["run_id", "status", "classification", "workflow", "events"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "completed", "blocked", "failed", "cancelled"]},
    "classification": {
      "type": "object",
      "required": ["materiality", "consequence"],
      "properties": {
        "materiality": {"enum": ["routine", "material"]},
        "consequence": {"enum": ["low", "medium", "high", "critical"]},
        "uncertainty": {"enum": ["low", "medium", "high"]}
      },
      "additionalProperties": false
    },
    "workflow": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_type", "status"],
        "properties": {
          "event_type": {"enum": ["route", "handoff", "tool", "approval", "evaluation", "reconciliation", "verification", "failure", "recovery", "completion"]},
          "status": {"type": "string", "minLength": 1},
          "reference": {"type": "string"},
          "summary": {"type": "string", "description": "Observable outcome summary only. Do not store hidden chain-of-thought."}
        },
        "additionalProperties": false
      }
    },
    "approval_refs": {"type": "array", "items": {"type": "string"}},
    "reconciliation_refs": {"type": "array", "items": {"type": "string"}},
    "residual_uncertainty": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
