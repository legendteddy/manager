{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/legendteddy/manager/contracts/model-request.schema.json",
  "title": "Manager Model Request",
  "type": "object",
  "required": ["request_id", "model", "input"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "instructions": {"type": "string"},
    "input": {
      "type": "string",
      "minLength": 1,
      "description": "Text input for the provider-neutral reference contract. For continuation turns this describes the bounded purpose of the turn; native provider adapters may map continuation.tool_results to structured provider input."
    },
    "max_output_tokens": {"type": "integer", "minimum": 1},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "input_schema"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "description": {"type": "string", "minLength": 1},
          "input_schema": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "continuation": {
      "type": "object",
      "required": ["prior_response_ref", "tool_results"],
      "properties": {
        "prior_response_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Provider-neutral reference to the immediately prior model response."
        },
        "tool_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["proposal_id", "status", "output"],
            "properties": {
              "proposal_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["executed"]},
              "output": {"type": "string"},
              "redacted": {"type": "boolean", "default": false}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "metadata": {"type": "object", "additionalProperties": true},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
